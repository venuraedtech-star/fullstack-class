generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id          Int          @id @default(autoincrement())
  title       String
  price       Decimal      @db.Decimal(10, 2)
  description String?
  imageUrl    String?      @map("image_url")
  createdAt   DateTime     @default(now()) @map("created_at")
  categoryId  Int?         @map("category_id")
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  tags        ProductTag[]
  cartItem    CartItem?
  comments    Comment[]

  @@map("products")
}

model Comment {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String   @map("author_name")
  text       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("comments")
}

model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId Int     @map("product_id")
  tagId     Int     @map("tag_id")
  product   Product @relation(fields: [productId], references: [id])
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
  @@map("product_tags")
}

// Descriptive only — the app's cart feature (models/cartModel.js,
// controllers/cartController.js) talks to this table directly via `pg`,
// not through Prisma Client. This model exists purely so Prisma's schema
// matches the live database and `migrate dev` doesn't try to drop
// cart_items on every future migration.
model CartItem {
  id        Int     @id @default(autoincrement())
  productId Int     @unique @map("product_id")
  quantity  Int     @default(1)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  name          String
  role          String         @default("customer")
  createdAt     DateTime       @default(now()) @map("created_at")
  refreshTokens RefreshToken[]
  orders        Order[]

  @@map("users")
}

// The storefront's cart/checkout works against the dummyjson.com catalog
// (external numeric ids), not this API's own `products` table — the two
// catalogs are unrelated. So OrderItem snapshots the product's title/price/
// image at purchase time by value instead of a foreign key, which is also
// just correct order-history practice (a later price change shouldn't
// rewrite what a customer already paid).
model Order {
  id            Int         @id @default(autoincrement())
  userId        Int         @map("user_id")
  user          User        @relation(fields: [userId], references: [id])
  totalAmount   Decimal     @db.Decimal(10, 2) @map("total_amount")
  status        String      @default("placed")
  fullName      String      @map("full_name")
  addressLine   String      @map("address_line")
  city          String
  state         String
  zip           String
  phone         String
  paymentMethod String      @map("payment_method")
  items         OrderItem[]
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("orders")
}

model OrderItem {
  id                Int     @id @default(autoincrement())
  orderId           Int     @map("order_id")
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  externalProductId Int     @map("external_product_id")
  title             String
  price             Decimal @db.Decimal(10, 2)
  quantity          Int
  imageUrl          String? @map("image_url")

  @@map("order_items")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
}
